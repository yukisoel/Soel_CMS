# 共通ベース
ACCOUNT_ID="211125631266"
PROJECT="cmssoel"
REGION="ap-northeast-1"
ZONE_NAME="${PROJECT}.click"

# 環境ごとに異なる値
ENV="dev"
FQDN="${ENV}.${ZONE_NAME}"

# 共通設定
DEPLOY_BUCKET="${PROJECT}-deploy-artifacts"
WORK_DIR=".work"
CF_EXEC_ROLE="arn:aws:iam::${ACCOUNT_ID}:role/CloudFormationExecutionRole"

# コンテナ・ECS関連
CONTAINER_PORT="8080"
CONTAINER_CPU="256"
CONTAINER_MEMORY="512"
DB_INSTANCE_CLASS="db.t4g.micro"

# 環境ごとにプレフィックスを動的に付与
PREFIX="${ENV}-${PROJECT}"

SECRET_NAME="${PREFIX}-secret"
ECR_REPO_NAME="${PREFIX}-ecr"
CLUSTER_NAME="${PREFIX}-cluster"
SERVICE_NAME="${PREFIX}-service"
TASK_NAME="${PREFIX}-ecs-task"
CONTAINER_NAME="${PREFIX}-app"
LOG_GROUP="/ecs/${PREFIX}"
APP_NAME="${PREFIX}-cd-app"
DG_NAME="${PREFIX}-dg"
USER_POOL_NAME="${PREFIX}-user-pool"
USER_POOL_CLIENT_NAME="${PREFIX}-user-pool-client"
